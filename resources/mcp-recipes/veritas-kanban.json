{
  "name": "veritas-kanban",
  "repository": "https://github.com/BradGroux/veritas-kanban.git",
  "ref": "v6.2.1",
  "install": [
    "HUSKY=0 pnpm install --frozen-lockfile --filter @veritas-kanban/mcp..."
  ],
  "build": [
    "pnpm --filter @veritas-kanban/shared build",
    "pnpm --filter @veritas-kanban/mcp build"
  ],
  "command": "node",
  "args": ["${INSTALL_DIR}/mcp/dist/index.js"],
  "env": {
    "NODE_ENV": "production",
    "VK_API_URL": "http://127.0.0.1:3001",
    "VK_API_KEY": "ira-veritas-local-agent-key-32b"
  },
  "env_requirements": ["VK_API_URL"]
}
