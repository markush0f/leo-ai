# cp .env.example .env

# Telegram rejects all users until its allowlist is configured.

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOW_USERS=

# DATABASE_URL=postgres://ira:ira@127.0.0.1:5439/ira?sslmode=disable

XAI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_HOST=http://127.0.0.1:11434
# IRA_HTTP_BIND=127.0.0.1:8787
# IRA_WEB_ROOT=desktop/dist

# Colibrì (JustVugg/colibri). Model directory must contain a converted model.
# COLIBRI_MODEL_DIR=/absolute/path/to/model
# COLIBRI_MODEL_ID=olmoe
# COLIBRI_RAM=16
# COLIBRI_PORT=8081

# AppFlowy Cloud (appflowy_write tool): email/password or an access token.
# APPFLOWY_BASE_URL=https://beta.appflowy.cloud
# APPFLOWY_GOTRUE_URL=https://beta.appflowy.cloud/gotrue
# APPFLOWY_EMAIL=
# APPFLOWY_PASSWORD=
# APPFLOWY_ACCESS_TOKEN=
# APPFLOWY_WORKSPACE_ID=
# APPFLOWY_PARENT_VIEW_ID=

# MCP Toolbox (imagen oficial fijada en docker-compose.yml).
# docker compose up -d postgres toolbox
MCP_TOOLBOX_URL=http://127.0.0.1:5000
# MCP_TOOLBOX_IMAGE=us-central1-docker.pkg.dev/database-toolbox/toolbox/toolbox:1.11.0
# MCP_TOOLBOX_TOOLSET=
# MCP_TOOLBOX_TOKEN=

# Cifra contraseñas de conexiones PostgreSQL. Si se omite, Ira crea
# .ira/master.key la primera vez y la reutiliza.
# IRA_MASTER_KEY=
# Ajusta si ira-server no corre con UID/GID 1000; Toolbox debe leer archivos 0600.
# IRA_UID=1000
# IRA_GID=1000
