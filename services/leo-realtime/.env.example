LEO_REALTIME_HOST=0.0.0.0
LEO_REALTIME_PORT=8765
LEO_REALTIME_MODE=echo
LEO_REALTIME_SAMPLE_RATE=16000
LEO_REALTIME_CHANNELS=1
LEO_REALTIME_LOG_LEVEL=INFO
# Comma-separated browser origins. Empty allows every origin for local testing.
LEO_REALTIME_ALLOWED_ORIGINS=
# Used when LEO_REALTIME_MODE=leo. leo-server default bind is 127.0.0.1:8787.
LEO_REALTIME_LEO_URL=http://127.0.0.1:8787
# Optional. Empty creates a new conversation per WebSocket session.
LEO_REALTIME_CONVERSATION_ID=
LEO_REALTIME_LEO_TIMEOUT_SECS=120
