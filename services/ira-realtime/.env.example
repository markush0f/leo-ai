IRA_REALTIME_HOST=0.0.0.0
IRA_REALTIME_PORT=8765
IRA_REALTIME_MODE=echo
IRA_REALTIME_SAMPLE_RATE=16000
IRA_REALTIME_CHANNELS=1
IRA_REALTIME_LOG_LEVEL=INFO
# Comma-separated browser origins. Empty allows every origin for local testing.
IRA_REALTIME_ALLOWED_ORIGINS=
# Used when IRA_REALTIME_MODE=ira. ira-server default bind is 127.0.0.1:8787.
IRA_REALTIME_IRA_URL=http://127.0.0.1:8787
# Optional. Empty creates a new conversation per WebSocket session.
IRA_REALTIME_CONVERSATION_ID=
IRA_REALTIME_IRA_TIMEOUT_SECS=120
# none | pocket (Kyutai Pocket TTS, CPU). First turn downloads weights from Hugging Face.
IRA_REALTIME_TTS=pocket
IRA_REALTIME_TTS_LANGUAGE=spanish
IRA_REALTIME_TTS_VOICE=lola
IRA_REALTIME_TTS_QUANTIZE=true
# Optional sampling temperature. Empty uses the model default.
IRA_REALTIME_TTS_TEMP=
