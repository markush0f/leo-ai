# Values used by the leo-local profile created during setup.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5439
POSTGRES_DATABASE=leo
POSTGRES_USER=leo
POSTGRES_PASSWORD=leo

# Optional generic Wren project/profile. Each project defines its datasource,
# models and dialect in wren_project.yml.
# WREN_PROJECT=/path/to/project
# WREN_PROFILE=my-database
# WREN_CONNECTION_FILE=/path/to/connection.yml
# WREN_CHECK_SQL=SELECT 1 AS connection_ok
# WREN_START_LOCAL_POSTGRES=false

# Optional, only for `leo-wren ask`.
OPENAI_API_KEY=
WREN_AGENT_MODEL=openai:gpt-4o-mini
