FROM node:22-alpine3.24

RUN apk add --no-cache git ca-certificates \
 && corepack enable \
 && corepack prepare pnpm@11.1.1 --activate \
 && npm install -g supergateway@3.4.3

WORKDIR /src
ARG VERITAS_REF=v6.2.1
RUN git clone --depth 1 --branch "${VERITAS_REF}" https://github.com/BradGroux/veritas-kanban.git . \
 && HUSKY=0 pnpm install --frozen-lockfile --filter @veritas-kanban/mcp... \
 && pnpm --filter @veritas-kanban/shared build \
 && pnpm --filter @veritas-kanban/mcp build \
 && rm -rf /root/.cache /root/.local/share/pnpm/store

WORKDIR /src/mcp
ENV NODE_ENV=production
ENV VK_API_URL=http://veritas-kanban:3001
EXPOSE 3100
COPY gateway.sh /gateway.sh
RUN chmod 755 /gateway.sh
CMD ["/gateway.sh"]
